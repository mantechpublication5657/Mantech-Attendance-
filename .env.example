# Copy this file to .env for local overrides, or set these in Vercel's
# project Settings -> Environment Variables for the deployed app.
# Every value here has a safe local-dev default in core/settings.py, so
# nothing in this file is required to run the project locally.

# --- Core Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://127.0.0.1:8000

# --- Database (Postgres, e.g. from Neon or Supabase) ---
# Leave unset locally to keep using the local db.sqlite3 file.
DATABASE_URL=

# --- Email (Gmail SMTP app password) ---
# Leave EMAIL_BACKEND unset locally to keep printing emails to the console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Cloudinary (media/profile-picture storage) ---
# Leave unset locally to keep storing uploads on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
